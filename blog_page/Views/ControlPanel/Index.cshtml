@model blog_page.Models.ViewModels.ControlPanelViewModel
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="container-fluid mt-4">
    <h2 class="mb-4 fw-bold text-dark">Genel Bakış</h2>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-white p-3 rounded-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-primary-subtle text-primary p-3 rounded-3">
                        <i class="bi bi-journal-text fs-3"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 small uppercase fw-bold">Toplam Blog</h6>
                        <h3 class="mb-0 fw-bold">@Model.blogCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-white p-3 rounded-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-success-subtle text-success p-3 rounded-3">
                        <i class="bi bi-check-circle fs-3"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 small fw-bold">Aktif Bloglar</h6>
                        <h3 class="mb-0 fw-bold">@Model.activeBlogCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-white p-3 rounded-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-info-subtle text-info p-3 rounded-3">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 small fw-bold">Toplam Üye</h6>
                        <h3 class="mb-0 fw-bold">@Model.totalUserCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border-0 shadow-sm h-100 bg-white p-3 rounded-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-danger-subtle text-danger p-3 rounded-3">
                        <i class="bi bi-person-x fs-3"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 small fw-bold">Banlı Üye</h6>
                        <h3 class="mb-0 fw-bold">@Model.toalBannedUserCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    <ul>
        @foreach (var post in Model.pendingBlogs)
        {
            <li>@post.Title</li>
        }
    </ul>
</div>