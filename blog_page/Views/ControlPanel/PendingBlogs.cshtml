@model IEnumerable<blog_page.Models.BlogPost>

<style>
    .pending-card { transition: all 0.3s ease; border: 1px solid #eee !important; }
    .pending-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.05) !important; border-color: #000 !important; }
    .card-img-wrapper { height: 180px; overflow: hidden; position: relative; }
    .status-badge { position: absolute; top: 15px; right: 15px; background: rgba(255, 193, 7, 0.9); backdrop-filter: blur(4px); color: #000; font-size: 10px; font-weight: 700; padding: 5px 12px; border-radius: 20px; }
    .meta-text { font-size: 12px; color: #adb5bd; }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-5 px-2">
        <div>
            <h2 class="fw-bold m-0 text-dark" style="letter-spacing: -1px;">Onay Bekleyen İçerikler</h2>
            <p class="text-muted small mb-0">Toplam @Model.Count() içerik inceleme bekliyor.</p>
        </div>
        <a href="/ControlPanel" class="btn btn-light btn-sm rounded-pill px-3 border shadow-sm text-muted">
            <i class="bi bi-arrow-left me-1"></i> Panele Dön
        </a>
    </div>

    <div class="row g-4">
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card pending-card h-100 border-0 rounded-4 overflow-hidden bg-white">
                        <div class="card-img-wrapper">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-blog.jpg" : item.ImageUrl)" 
                                 class="w-100 h-100 object-fit-cover" alt="@item.Title">
                            <span class="status-badge shadow-sm">BEKLEMEDE</span>
                        </div>

                        <div class="card-body p-4">
                            <div class="mb-2">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-1 fw-normal" style="font-size: 11px;">
                                    @item.CategoryFk?.Name
                                </span>
                            </div>
                            
                            <h5 class="fw-bold text-dark mb-3">@item.Title</h5>
                            
                            <div class="d-flex align-items-center mb-4">
                                <img src="https://ui-avatars.com/api/?name=@item.AuthorFkuser?.Username&background=000&color=fff" 
                                     class="rounded-circle me-2" width="24">
                                <div class="meta-text">
                                    <span class="fw-bold text-dark">@item.AuthorFkuser?.Username</span> 
                                    <span class="mx-1">•</span> 
                                    @item.CreatedAt.ToString("dd MMM yyyy")
                                </div>
                            </div>

                            <div class="d-flex gap-2 pt-3 border-top">
                                <a href="/Details/@item.Slug" class="btn btn-outline-dark btn-sm rounded-pill px-3 flex-grow-1 fw-bold">
                                    <i class="bi bi-eye me-1"></i> İncele
                                </a>
                                <form asp-action="ApproveBlog" asp-route-id="@item.PostId" method="post" class="flex-grow-1">
                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 w-100 fw-bold shadow-sm">
                                        <i class="bi bi-check2 me-1"></i> Yayınla
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white">
                    <div class="display-1 text-success opacity-25 mb-3">
                        <i class="bi bi-check-all"></i>
                    </div>
                    <h4 class="fw-bold">Harika!</h4>
                    <p class="text-muted">Şu an onay bekleyen herhangi bir döküman bulunmuyor.</p>
                </div>
            </div>
        }
    </div>
</div>