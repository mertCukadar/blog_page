@model IEnumerable<blog_page.Models.User>

<style>
    .user-row { transition: all 0.2s; border: 1px solid #eee !important; margin-bottom: 10px; border-radius: 16px; }
    .user-row:hover { border-color: #000 !important; background-color: #fff !important; box-shadow: 0 5px 15px rgba(0,0,0,0.02); }
    .search-input { border-radius: 12px; border: 1px solid #eee; padding: 12px 20px; background: #fff; transition: all 0.2s; }
    .search-input:focus { border-color: #000; box-shadow: none; outline: none; }
    .ban-btn { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 10px; }
</style>

<div class="container-fluid py-4">
    <div class="row align-items-center mb-5 px-2">
        <div class="col-md-6">
            <h2 class="fw-bold m-0" style="letter-spacing: -1px;">Topluluk Yönetimi</h2>
            <p class="text-muted small mb-0">Platformdaki tüm kayıtlı kullanıcıları yönetin.</p>
        </div>
        <div class="col-md-6 mt-3 mt-md-0">
            <form method="get" asp-action="Users" class="position-relative">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="search-input w-100" placeholder="Kullanıcı adı veya e-posta ile ara...">
                <button type="submit" class="btn position-absolute end-0 top-50 translate-middle-y me-2 border-0">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
    </div>

    <div class="px-2">
        @if (Model.Any())
        {
            @foreach (var user in Model)
            {
                <div class="card user-row bg-white border-0 p-3 shadow-none">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <img src="https://ui-avatars.com/api/?name=@user.Username&background=f8f9fa&color=000" class="rounded-circle border" width="45">
                        </div>
                        <div class="col">
                            <h6 class="fw-bold m-0">@user.Username</h6>
                            <small class="text-muted">@user.Email</small>
                        </div>
                        <div class="col-md-2 d-none d-md-block text-center border-start border-end">
                            <small class="text-muted d-block" style="font-size: 10px;">KATILIM</small>
                            <span class="small fw-semibold">@user.CreatedAt.ToString("MMM yyyy")</span>
                        </div>
                        <div class="col-md-2 d-none d-md-block px-3">
                            <div class="d-flex gap-1 flex-wrap">
                                @foreach (var role in user.UserRoles)
                                {
                                    <span class="badge bg-light text-dark border rounded-pill" style="font-size: 10px;">@role.RoleFk.Name</span>
                                }
                            </div>
                        </div>
                        <div class="col-auto text-end">
                            <div class="d-flex gap-2">
                                @if (user.IsBanned)
                                {
                                    <form asp-action="UnbanUser" asp-route-id="@user.Id" method="post">
                                        <button type="submit" class="btn btn-outline-success ban-btn" title="Kısıtlamayı Kaldır">
                                            <i class="bi bi-person-check"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="BanUser" asp-route-id="@user.Id" method="post">
                                        <button type="submit" class="btn btn-outline-danger ban-btn" title="Kullanıcıyı Yasakla">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    </form>
                                }
                                
                                <button type="button" class="btn btn-dark border ban-btn" data-bs-toggle="modal" data-bs-target="#roleModal-@user.Id" title="Yetkileri Yönet">
                                    <i class="bi bi-shield-lock"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="roleModal-@user.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-sm">
                        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                            <div class="modal-header border-0 pb-0">
                                <h6 class="modal-title fw-bold">Yetki Yönetimi</h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-action="UpdateUserRoles" method="post">
                                <div class="modal-body py-4">
                                    <div class="text-center mb-4">
                                        <img src="https://ui-avatars.com/api/?name=@user.Username&background=f8f9fa&color=000" class="rounded-circle mb-2 border" width="60">
                                        <p class="m-0 fw-bold fs-5">@user.Username</p>
                                        <small class="text-muted">Kullanıcı rollerini güncelleyin</small>
                                    </div>

                                    <input type="hidden" name="userId" value="@user.Id" />

                                    <div class="d-flex flex-column gap-3 px-3">
                                        @if (ViewBag.AllRoles != null)
                                            {
                                                @foreach (var role in ViewBag.AllRoles)
                                                {
                                                
                                                 var hasRole = user.UserRoles.Any(ur => ur.RoleFkid == role.RoleId);
                                                

                                                <div class="form-check custom-control d-flex align-items-center mb-2">
                                                    <input class="form-check-input border-secondary shadow-none" 
                                                           style="width: 1.2rem; height: 1.2rem; cursor: pointer;" 
                                                           type="checkbox" 
                                                           name="selectedRoles" 
                                                           value="@role.RoleId" 
                                                           id="role_@(user.Id)_@(role.RoleId)" 
                                                           checked="@hasRole">
           
                                                    <label class="form-check-label ms-2 fw-semibold w-100" for="role_@(user.Id)_@(role.RoleId)" style="cursor: pointer; padding-top: 2px;">
                                                        @role.Name
                                                    </label>
                                                </div>
                                                                                                }
                                            }
                                    </div>
                                </div>
                                <div class="modal-footer border-0 pt-0 justify-content-center pb-4 gap-2">
                                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">İptal</button>
                                    <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">Kaydet</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border">
                <i class="bi bi-person-dash display-4 text-muted opacity-25"></i>
                <p class="mt-3 text-muted">Aradığınız kriterlere uygun kullanıcı bulunamadı.</p>
                <a href="/ControlPanel/Users" class="btn btn-dark btn-sm rounded-pill px-4">Tümünü Göster</a>
            </div>
        }
    </div>
</div>