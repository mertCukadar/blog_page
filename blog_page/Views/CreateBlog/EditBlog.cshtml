@model blog_page.Models.ViewModels.EditBlogViewModel

<style>
    .create-card { border-radius: 24px; border: 1px solid #eee !important; }
    .form-control, .form-select { border: 1px solid #eee; background-color: #fcfcfc; transition: all 0.2s; }
    .form-control:focus, .form-select:focus { background-color: #fff; border-color: #000; box-shadow: none; }
    .ql-toolbar.ql-snow { border: 1px solid #eee !important; border-top-left-radius: 12px; border-top-right-radius: 12px; background: #fafafa; }
    .ql-container.ql-snow { border: 1px solid #eee !important; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; font-family: 'Inter', sans-serif; font-size: 1rem; }
    .input-label { font-size: 11px; letter-spacing: 1px; color: #adb5bd; text-transform: uppercase; margin-bottom: 8px; display: block; }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex align-items-center justify-content-between mb-4 px-2">
                <div>
                    <h2 class="fw-bold m-0 text-dark" style="letter-spacing: -1px;">Dökümanı Düzenle</h2>
                    <p class="text-muted small mb-0">İçeriğini güncelleyerek daha iyi bir kaynak yarat.</p>
                </div>
                <a asp-action="MyBlogs" class="text-muted text-decoration-none small">
                    <i class="bi bi-x-lg me-1"></i> İptal
                </a>
            </div>

            <div class="card create-card border-0 shadow-sm bg-white p-4 p-lg-5">
                <form asp-action="EditBlog" method="post" enctype="multipart/form-data" id="editBlogForm">
                    <input type="hidden" asp-for="PostId" />
                    
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="Title" class="input-label fw-bold">YAZI BAŞLIĞI</label>
                            <input asp-for="Title" class="form-control form-control-lg rounded-3" required>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategorieID" class="input-label fw-bold">KATEGORİ</label>
                            <select asp-for="CategorieID" asp-items="Model.CategoryList" class="form-select form-select-lg rounded-3">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="input-label fw-bold">KAPAK GÖRSELİ (DEĞİŞTİRMEK İSTERSENİZ)</label>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" class="rounded-3 border" width="80" height="60" style="object-fit: cover;">
                                }
                                <input type="file" name="newImage" class="form-control rounded-3" accept="image/*">
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <label class="input-label fw-bold">İÇERİK DETAYLARI</label>
                            <div id="editor-container" style="height: 400px;" class="bg-white">
                                @Html.Raw(Model.BlogContent)
                            </div>
                            <input type="hidden" asp-for="BlogContent" id="hiddenContent" />
                        </div>

                        <div class="col-12 mt-5">
                            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-4">
                                <span class="text-muted small ps-2">
                                    <i class="bi bi-info-circle me-1"></i> Düzenleme sonrası onay sürecine girebilir.
                                </span>
                                <button type="submit" class="btn btn-dark btn-lg rounded-pill px-5 shadow-sm">
                                    Değişiklikleri Kaydet <i class="bi bi-check2 ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <script>
        var quill = new Quill('#editor-container', {
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, false] }],
                    ['bold', 'italic', 'underline'],
                    ['code-block', 'blockquote'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            },
            theme: 'snow'
        });

        // Form gönderilirken güncel içeriği hidden input'a aktar
        var form = document.getElementById('editBlogForm');
        form.onsubmit = function() {
            var content = document.querySelector('#hiddenContent');
            content.value = quill.root.innerHTML;
            return true;
        };
    </script>
}