@model blog_page.Models.ViewModels.BlogCreateViewModel

<style>
    .create-card { border-radius: 24px; border: 1px solid #eee !important; }
    .form-control, .form-select { border: 1px solid #eee; background-color: #fcfcfc; transition: all 0.2s; }
    .form-control:focus, .form-select:focus { background-color: #fff; border-color: #000; box-shadow: none; }
    
    /* Quill Editör Özelleştirme */
    .ql-toolbar.ql-snow { border: 1px solid #eee !important; border-top-left-radius: 12px; border-top-right-radius: 12px; background: #fafafa; }
    .ql-container.ql-snow { border: 1px solid #eee !important; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; font-family: 'Inter', sans-serif; font-size: 1rem; }
    
    .input-label { font-size: 11px; letter-spacing: 1px; color: #adb5bd; text-transform: uppercase; margin-bottom: 8px; display: block; }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex align-items-center justify-content-between mb-4 px-2">
                <div>
                    <h2 class="fw-bold m-0 text-dark" style="letter-spacing: -1px;">Yeni İçerik</h2>
                    <p class="text-muted small mb-0">Bilgiyi paylaşmak, onu kalıcı kılar.</p>
                </div>
                <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small">
                    <i class="bi bi-x-lg me-1"></i> Vazgeç
                </a>
            </div>

            <div class="card create-card border-0 shadow-sm bg-white p-4 p-lg-5">
                <form asp-controller="CreateBlog" asp-action="CreateBlog" method="post" enctype="multipart/form-data" id="blogForm">
                    
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="Title" class="input-label fw-bold">YAZI BAŞLIĞI</label>
                            <input asp-for="Title" class="form-control form-control-lg rounded-3" placeholder="Başlığı buraya girin..." required>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategorieID" class="input-label fw-bold">KATEGORİ</label>
                            <select asp-for="CategorieID" asp-items="Model.CategoryList" class="form-select form-select-lg rounded-3">
                                <option value="">Seçiniz...</option>
                            </select>
                            <span asp-validation-for="CategorieID" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ImageFile" class="input-label fw-bold">KAPAK GÖRSELİ</label>
                            <div class="input-group">
                                <input asp-for="ImageFile" type="file" class="form-control rounded-3" accept="image/*">
                            </div>
                            <div class="form-text text-muted" style="font-size: 11px;">
                                <i class="bi bi-info-circle me-1"></i> İdeal boyut: 1200x630px. Seçilmezse sistem varsayılan görseli atar.
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <label class="input-label fw-bold">İÇERİK DETAYLARI</label>
                            <div id="editor-container" style="height: 400px;" class="bg-white"></div>
                            <input type="hidden" asp-for="BlogContent" id="hiddenContent" />
                            <span asp-validation-for="BlogContent" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-5">
                            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-4">
                                <span class="text-muted small ps-2">
                                    <i class="bi bi-shield-lock me-1"></i> İçerik önce moderatör onayına düşecektir.
                                </span>
                                <button type="submit" class="btn btn-dark btn-lg rounded-pill px-5 shadow-sm">
                                    Yazıyı Tamamla <i class="bi bi-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <script>
        var quill = new Quill('#editor-container', {
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, false] }],
                    ['bold', 'italic', 'underline'],
                    ['code-block', 'blockquote'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            },
            placeholder: 'Teknik detayları buraya yazmaya başlayın...',
            theme: 'snow'
        });

        var form = document.getElementById('blogForm');
        form.onsubmit = function() {
            var content = document.querySelector('#hiddenContent');
            content.value = quill.root.innerHTML;
            return true;
        };
    </script>
}