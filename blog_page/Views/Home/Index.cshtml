@model IEnumerable<blog_page.Models.BlogPost>

<style>
    .blog-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); border: 1px solid #eee !important; }
    .blog-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.05) !important; border-color: #000 !important; }
    .blog-image-container { overflow: hidden; position: relative; }
    .blog-image { transition: transform 0.5s ease; object-fit: cover; }
    .blog-card:hover .blog-image { transform: scale(1.05); }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <h2 class="fw-bold m-0 text-dark" style="letter-spacing: -1px;">Son Paylaşımlar</h2>
            <p class="text-muted small mb-0">Teknoloji ve yazılım üzerine güncel dökümanlar.</p>
        </div>
        <div class="d-none d-md-block">
            <span class="badge bg-white text-dark border rounded-pill px-3 py-2">
                <i class="bi bi-funnel me-1"></i> Filtrele
            </span>
        </div>
    </div>
    
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card blog-card h-100 border-0 rounded-4 overflow-hidden bg-white">
                    <div class="row g-0">
                        @* Resim Alanı *@
                        <div class="col-md-4 blog-image-container">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-blog.jpg" : item.ImageUrl)"
                                 class="blog-image h-100 w-100"
                                 style="min-height: 250px;" alt="@item.Title">
                        </div>
                        
                        @* İçerik Alanı *@
                        <div class="col-md-8">
                            <div class="card-body p-4 p-lg-5 d-flex flex-column h-100">
                                <div class="mb-3 d-flex align-items-center">
                                    <span class="badge bg-dark text-white rounded-pill px-3 py-2 small fw-normal">
                                        @item.CategoryFk?.Name
                                    </span>
                                    <div class="vr mx-3 opacity-10"></div>
                                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> @item.CreatedAt.ToString("dd MMM yyyy")</small>
                                </div>
                                
                                <h3 class="card-title fw-bold mb-3">
                                    <a href="/Details/@item.Slug" class="text-decoration-none text-dark hover-primary">@item.Title</a>
                                </h3>
                                
                                <p class="card-text text-secondary mb-4 line-clamp-2">
                                    @{
                                        // HTML etiketlerini temizle ve temiz özet göster
                                        var cleanText = System.Text.RegularExpressions.Regex.Replace(item.BlogContent ?? "", "<.*?>", string.Empty);
                                    }
                                    @cleanText
                                </p>
                                
                                <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bi bi-person text-dark" style="font-size: 0.8rem;"></i>
                                        </div>
                                        <small class="fw-bold text-dark">@item.AuthorFkuser?.Username</small>
                                    </div>
                                    
                                    <div class="d-flex align-items-center gap-3">
                                        <small class="text-muted"><i class="bi bi-eye me-1"></i> @item.ViewCount</small>
                                        <a href="/Details/@item.Slug" class="btn btn-dark btn-sm rounded-pill px-4">
                                            İncele <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>