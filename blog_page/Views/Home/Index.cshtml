@model IEnumerable<blog_page.Models.BlogPost>

<style>
    .compact-card { transition: all 0.25s ease-in-out; border: 1px solid #f0f0f0 !important; height: 100%; }
    .compact-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important; border-color: #000 !important; }
    .card-img-top-custom { height: 160px; object-fit: cover; }
    .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.85rem; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    
    /* Carousel ve Yan Panel Yükseklik Eşitlemesi */
    .hero-section-height { height: 400px; }
/* Carousel ve Yan Panel Yükseklik Eşitlemesi */
.news-slider { border-radius: 20px; overflow: hidden; background: #000; height: 100%; }

.slider-caption { 
    background: linear-gradient(transparent, rgba(0,0,0,0.8)); 
    padding: 40px 20px 20px !important; 
    z-index: 20; /* İŞTE KRİTİK DOKUNUŞ BURASI */
}
    
    /* Yan Panel Liste Stili */
    .recent-post-item { transition: background 0.2s; border-radius: 12px; padding: 10px; }
    .recent-post-item:hover { background: #f8f9fa; }
    .recent-img { width: 70px; height: 70px; object-fit: cover; border-radius: 10px; }
</style>

<div class="container py-4">

    <div class="row g-4 mb-5 hero-section-height">
        
        <div class="col-lg-8 h-100">
            @if (Model.Any())
            {
                <div id="newsCarousel" class="carousel slide news-slider shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-inner h-100">
                        @{ var first = true; }
                        @foreach (var item in Model.Take(3))
                        {
                            <div class="carousel-item h-100 @(first ? "active" : "")">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-blog.jpg" : item.ImageUrl)" 
                                     class="d-block w-100 h-100 object-fit-cover opacity-75" alt="...">
                                <div class="carousel-caption text-start slider-caption d-none d-md-block w-100 start-0 bottom-0">
                                    <div class="container px-4">
                                        <span class="badge bg-primary mb-2 shadow-sm">Öne Çıkan</span>
                                        <h3 class="fw-bold text-white mb-2 shadow-sm">@item.Title</h3>
                                        <a href="/Details/@item.Slug" class="btn btn-light btn-sm rounded-pill px-4 mt-2 fw-bold">Oku</a>
                                    </div>
                                </div>
                            </div>
                            first = false;
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#newsCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#newsCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>
            }
        </div>

        <div class="col-lg-4 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3 px-2 pt-2">
                    <h6 class="fw-bold m-0" style="letter-spacing: -0.5px;">Son Eklenenler</h6>
                </div>
                
                <div class="d-flex flex-column gap-1 overflow-auto pe-1" style="flex-grow: 1;">
                    @* Slider'daki ilk 3'ü atlayıp sonraki 5'i listeliyoruz (İsteğe göre Skip(0) da yapılabilir) *@
                    @foreach (var item in Model.Skip(3).Take(5))
                    {
                        <a href="/Details/@item.Slug" class="text-decoration-none text-dark recent-post-item d-flex align-items-center">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-blog.jpg" : item.ImageUrl)" 
                                 class="recent-img shadow-sm" alt="...">
                            <div class="ms-3">
                                <h6 class="mb-1 fw-bold line-clamp-2" style="font-size: 13px;">@item.Title</h6>
                                <small class="text-muted" style="font-size: 11px;">
                                    <i class="bi bi-calendar3 me-1"></i>@item.CreatedAt.ToString("dd MMM yyyy")
                                </small>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
        <div>
            <h4 class="fw-bold m-0">Tüm Dökümanlar</h4>
            <small class="text-muted">Toplam @Model.Count() döküman listeleniyor.</small>
        </div>
        <div class="dropdown">
            <button class="btn btn-white border rounded-pill btn-sm px-3 dropdown-toggle shadow-sm" data-bs-toggle="dropdown">
                <i class="bi bi-sort-down me-1"></i> Sırala
            </button>
            <ul class="dropdown-menu border-0 shadow">
                <li><a class="dropdown-item small" href="#">En Yeni</a></li>
                <li><a class="dropdown-item small" href="#">En Çok Okunan</a></li>
            </ul>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card compact-card border-0 rounded-4 overflow-hidden bg-white">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-blog.jpg" : item.ImageUrl)"
                             class="card-img-top card-img-top-custom" alt="@item.Title">
                        <span class="position-absolute top-0 end-0 m-3 badge bg-dark bg-opacity-75 rounded-pill px-2" style="font-size: 10px;">
                            @item.CategoryFk?.Name
                        </span>
                    </div>

                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex align-items-center mb-2" style="font-size: 11px;">
                            <span class="text-muted"><i class="bi bi-calendar3 me-1"></i> @item.CreatedAt.ToString("dd MMM")</span>
                            <span class="mx-2 text-light">|</span>
                            <span class="text-muted"><i class="bi bi-eye me-1"></i> @item.ViewCount Okunma</span>
                        </div>

                        <h6 class="card-title fw-bold text-dark mb-2">
                            <a href="/Details/@item.Slug" class="text-decoration-none text-dark">@item.Title</a>
                        </h6>

                        <p class="card-text text-secondary line-clamp-3 mb-3">
                            @{
                                var cleanText = System.Text.RegularExpressions.Regex.Replace(item.BlogContent ?? "", "<.*?>", string.Empty);
                            }
                            @cleanText
                        </p>

                        <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=@item.AuthorFkuser?.Username&background=000&color=fff" 
                                     class="rounded-circle me-2" width="20">
                                <small class="fw-bold text-muted" style="font-size: 11px;">@item.AuthorFkuser?.Username</small>
                            </div>
                            <a href="/Details/@item.Slug" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1" style="font-size: 11px;">
                                İncele <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>