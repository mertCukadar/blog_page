<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yönetim Paneli</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body { background-color: #f4f7f6; font-family: 'Inter', sans-serif; }

        /* Sidebar Sabit ve Her Zaman Açık */
        .sidebar { 
            width: 260px; height: 100vh; position: fixed; 
            left: 0; top: 0; background: #fff; border-right: 1px solid #e9ecef;
            display: flex; flex-direction: column; z-index: 1000;
        }

        /* Logo ve Profil Alanı (Üst Bölüm - Farklı Renk Tonu) */
        .brand-section {
            background-color: #fafafa; /* Burayı bir tık farklı yaptık */
            padding: 25px;
            border-bottom: 1px solid #eee;
            text-align: center;
        }

        /* İçerik Alanı (Sidebar genişliği kadar soldan boşluk) */
        .main-content { margin-left: 260px; min-height: 100vh; }

        /* Menü Linkleri */
        .nav-link { 
            color: #555; border-radius: 10px; padding: 12px 15px; margin: 5px 15px;
            font-size: 0.9rem; font-weight: 500; transition: all 0.2s;
        }
        .nav-link:hover { background-color: #f8f9fa; color: #000; }
        .nav-link.active { background-color: #000; color: #fff; }
        
        .nav-link i { margin-right: 12px; font-size: 1.1rem; }

        .nav-heading {
            font-size: 11px; letter-spacing: 1.2px; color: #bbb;
            margin: 20px 30px 10px; text-transform: uppercase; font-weight: 700;
        }
    </style>
</head>
<body>

    <nav class="sidebar">
        <div class="brand-section">
          
            
            <div class="p-2 border rounded-4 bg-white shadow-sm mt-3">
                <div class="d-flex align-items-center">
                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=000&color=fff" 
                         class="rounded-circle me-2" width="35">
                    <div class="text-start overflow-hidden">
                        <p class="mb-0 fw-bold small text-truncate" style="max-width: 120px;">@User.Identity.Name</p>
                        <span class="text-success fw-bold" style="font-size: 9px;">● ONLINE</span>
                    </div>
                </div>
            </div>
        </div>

        <p class="nav-heading">Navigasyon</p>
        <ul class="nav flex-column mb-auto">
            <li><a class="nav-link active" href="/ControlPanel"><i class="bi bi-house-door"></i> Dashboard</a></li>
            <li><a class="nav-link" href="/ControlPanel/PendingBlogs"><i class="bi bi-patch-check"></i> Onaylar</a></li>
            <li><a class="nav-link" href="/ControlPanel/Users"><i class="bi bi-people"></i> Kullanıcılar</a></li>
            <li><a class="nav-link" href="/ControlPanel/Categories"><i class="bi bi-folder"></i> Kategoriler</a></li>
        </ul>

        <div class="p-4 border-top">
            <a href="/" class="btn btn-light w-100 rounded-pill btn-sm border text-muted fw-bold">
                <i class="bi bi-arrow-left"></i> Siteye Dön
            </a>
        </div>
    </nav>

    <div class="main-content">
        <nav class="navbar navbar-light p-4">
            <div class="container-fluid">
                <span class="navbar-text fw-bold text-muted small">
                    Yönetim Paneli / @ViewData["Title"]
                </span>
                <div class="ms-auto bg-white p-2 px-3 rounded-pill shadow-sm border small text-muted">
                    @DateTime.Now.ToShortDateString() <i class="bi bi-calendar3 ms-2"></i>
                </div>
            </div>
        </nav>

        <div class="container-fluid px-4 px-md-5">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>