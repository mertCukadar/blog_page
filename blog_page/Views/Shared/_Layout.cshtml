<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TEK-BLOG</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root { --soft-bg: #f8f9fa; --primary-dark: #1a1a1a; }
        body { background-color: var(--soft-bg); font-family: 'Inter', system-ui, sans-serif; color: #333; }
        
        /* Navbar Sadeleştirme */
        .navbar { background: rgba(255, 255, 255, 0.8) !important; backdrop-filter: blur(10px); border-bottom: 1px solid #eee; }
        .navbar-brand { letter-spacing: -0.5px; }
        
        .nav-link { font-weight: 500; color: #555 !important; transition: color 0.2s; }
        .nav-link:hover { color: var(--primary-dark) !important; }

        /* Dropdown Modernizasyonu */
        .dropdown-menu { border: none; shadow: 0 10px 30px rgba(0,0,0,0.08); border-radius: 12px; padding: 8px; margin-top: 10px !important; }
        .dropdown-item { border-radius: 8px; padding: 8px 16px; font-size: 0.9rem; }
        .dropdown-item:hover { background-color: #f8f9fa; color: #000; }

        /* Kayıt Ol Butonu Sadeleştirme */
        .btn-primary { background-color: var(--primary-dark); border: none; border-radius: 10px; padding: 8px 20px; font-weight: 500; }
        .btn-primary:hover { background-color: #000; transform: translateY(-1px); }
        
        .avatar-circle { border: 2px solid #eee; transition: transform 0.2s; }
        .avatar-circle:hover { transform: scale(1.05); }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-dark d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <div class="bg-dark text-white rounded-2 p-1 me-2" style="line-height: 1;">
                        <i class="bi bi-cpu" style="font-size: 1.2rem;"></i>
                    </div>
                    MertKaan.Blog
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto ms-lg-4">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="catDrop" data-bs-toggle="dropdown">
                                <i class="bi bi-grid-3x3-gap me-2"></i>Kategoriler
                            </a>
                            <ul class="dropdown-menu shadow border-0">
                                @await Component.InvokeAsync("CategoryMenu")
                            </ul>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=000&color=fff" 
                                         class="rounded-circle avatar-circle me-2" width="32">
                                    <span class="fw-semibold">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Index"><i class="bi bi-person me-2 text-muted"></i>Hesabım</a></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="MyBlogs""><i class="bi bi-journal-text me-2 text-muted"></i>Bloglarım</a></li>
                                    
                                    @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                                    {
                                        <li><hr class="dropdown-divider opacity-50"></li>
                                        <li><a class="dropdown-item text-primary fw-bold" asp-controller="ControlPanel" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Panel</a></li>
                                    }
                                    
                                    <li><hr class="dropdown-divider opacity-50"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="px-2">
                                            <button type="submit" class="btn btn-light btn-sm w-100 text-danger rounded-3 fw-bold">
                                                <i class="bi bi-box-arrow-right me-2"></i>Çıkış
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link px-3" asp-controller="Auth" asp-action="Login">Giriş</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm ms-lg-3 px-4 shadow-sm" asp-controller="Auth" asp-action="Register">Kayıt Ol</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container" style="margin-top: 100px;">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="py-5 border-top bg-white mt-5">
        <div class="container text-center">
            <p class="text-muted small mb-0">© @DateTime.Now.Year TEK-BLOG | Mert Kaan Çukadar</p>
            <div class="mt-2 h4">
                <i class="bi bi-github mx-2 text-muted"></i>
                <i class="bi bi-linkedin mx-2 text-muted"></i>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>