@model blog_page.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
}

<style>
    .security-card { border-radius: 24px; border: 1px solid #eee !important; }
    .input-label { font-size: 11px; letter-spacing: 1px; color: #adb5bd; text-transform: uppercase; margin-bottom: 8px; display: block; }
    .form-control-custom { background-color: #f8f9fa; border: 1px solid #eee; border-radius: 12px; padding: 14px 16px; transition: all 0.2s; }
    .form-control-custom:focus { background-color: #fff; border-color: #000; box-shadow: 0 0 0 4px rgba(0,0,0,0.05); outline: none; }
    .requirement-list { font-size: 12px; color: #6c757d; }
    .requirement-list i { font-size: 10px; margin-right: 6px; }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            
            <div class="mb-4">
                <a asp-controller="User" asp-action="Index" class="text-muted text-decoration-none small fw-bold">
                    <i class="bi bi-arrow-left me-1"></i> Profile Dön
                </a>
            </div>

            <div class="card security-card border-0 shadow-sm bg-white p-4 p-md-5">
                
                <div class="text-center mb-5">
                    <div class="bg-light d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-shield-lock fs-3 text-dark"></i>
                    </div>
                    <h3 class="fw-bold m-0" style="letter-spacing: -0.5px;">Güvenlik Ayarları</h3>
                    <p class="text-muted small mt-2">Hesap güvenliğiniz için şifrenizi güncelleyin.</p>
                </div>

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="CurrentPassword" class="input-label fw-bold">Mevcut Şifre</label>
                        <input asp-for="CurrentPassword" type="password" class="form-control-custom w-100" placeholder="••••••••" required>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <hr class="border-light my-4">

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="input-label fw-bold">Yeni Şifre</label>
                        <input asp-for="NewPassword" type="password" class="form-control-custom w-100" placeholder="••••••••" required>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="input-label fw-bold">Yeni Şifre (Tekrar)</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control-custom w-100" placeholder="••••••••" required>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="bg-light p-3 rounded-3 mb-4 requirement-list">
                        <p class="mb-2 fw-bold text-dark" style="font-size: 11px;">ŞİFRE GEREKSİNİMLERİ</p>
                        <div class="d-flex flex-column gap-1">
                            <span><i class="bi bi-circle-fill text-muted"></i> En az 8 karakter uzunluğunda</span>
                            <span><i class="bi bi-circle-fill text-muted"></i> Büyük ve küçük harf içermeli</span>
                            <span><i class="bi bi-circle-fill text-muted"></i> En az bir rakam veya özel karakter</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark btn-lg w-100 rounded-pill fw-bold shadow-sm">
                        Şifreyi Güncelle <i class="bi bi-check2 ms-1"></i>
                    </button>
                </form>

            </div>
            
            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i> Şifrenizi unuttuysanız sistem yöneticisi ile iletişime geçin.
                </p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}